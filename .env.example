# Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Use a long random value in production.
APP_SECRET=replace_with_at_least_32_random_characters

# Optional comma-separated list for cross-origin API calls.
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Stores contact, newsletter, and order-request JSONL records.
DATA_DIR=./data

# Optional webhook for Slack, Make, Zapier, CRM, or support inbox automation.
LEAD_NOTIFICATION_WEBHOOK_URL=

# Optional live billing. Without these, the app runs in demo billing mode.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
